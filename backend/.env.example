# Copy this file to .env (it is in .gitignore). It runs without a key: Copilot falls back to rule-based analysis, the VLM falls back to simulated perception.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # for Copilot
OPENAI_VISION_MODEL=gpt-4o-mini     # for the VLM (image support is necessary)
# OPENAI_BASE_URL=                  # optional compatible endpoint (Azure / local proxy)
TWIN_VLM_ACTS=0                     # 1 = when the VLM detects a person, really block the Zone (this disturbs the simulation; enable for a fully automatic Demo 03)
TWIN_SEED=42

# ── Public deployment protection (local development can leave all unset) ──
# TWIN_CORS_ORIGINS=https://ware-twin.vercel.app   # comma-separated; when set, WebSocket and POST must carry an allowed Origin
# TWIN_CORS_REGEX=https://ware-twin-[a-z0-9]+-<scope-slug>\.vercel\.app   # do not set for production; add it only for Vercel preview, and lock it to your own scope slug
# TWIN_TRUSTED_PROXIES=1                          # use the Nth segment from the end of X-Forwarded-For as the client IP (Render=1; direct local connection: 0)
# TWIN_ALLOW_NO_ORIGIN=0                           # 1 = allow requests without an Origin (curl / scripts)
# TWIN_RATE_LIMIT=1                                # 0 = disable the rate limit (per IP: mutate 20/min, ai 10/min, what-if 4/min)
# TWIN_HEALTH_STALL_S=10                           # number of seconds without simulation progress before /api/health returns 503
